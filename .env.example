# MinIO Object Storage
# Root username for MinIO (acts as the access key)
MINIO_ROOT_USER=minioadmin

# Root password for MinIO (acts as the secret key)
MINIO_ROOT_PASSWORD=minioadmin

# Port for MinIO S3-compatible API
MINIO_API_PORT=9000

# Port for MinIO web console
MINIO_CONSOLE_PORT=9001

# Port for Project Nessie catalog REST API
NESSIE_PORT=19120

# Port for Trino distributed SQL query engine
TRINO_PORT=8080
